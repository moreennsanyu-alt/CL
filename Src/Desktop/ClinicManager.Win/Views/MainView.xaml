<UserControl x:Class="ClinicManager.Win.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:mvvm="clr-namespace:ClinicManager.Win.Presentation.Mvvm"
             prism:ViewModelLocator.AutoWireViewModel="True"
             AutomationProperties.AutomationId="MainView">
    <DockPanel Background="{DynamicResource SurfaceBrush}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button x:Name="HomeNavButton" AutomationProperties.AutomationId="HomeNavButton"
                    Content="Home" Command="{Binding NavigateCommand}" CommandParameter="{x:Static mvvm:ViewNames.Home}" />
            <Button x:Name="DashboardNavButton" AutomationProperties.AutomationId="DashboardNavButton"
                    Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="{x:Static mvvm:ViewNames.Dashboard}" />
        </StackPanel>
        <ContentControl x:Name="ContentRegion"
                        AutomationProperties.AutomationId="ContentRegion"
                        prism:RegionManager.RegionName="{x:Static mvvm:RegionNames.Content}" />
    </DockPanel>
</UserControl>
