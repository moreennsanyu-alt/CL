<Window x:Class="ClinicManager.Win.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
        xmlns:mvvm="clr-namespace:ClinicManager.Win.Presentation.Mvvm"
        prism:ViewModelLocator.AutoWireViewModel="True"
        AutomationProperties.AutomationId="ShellWindow"
        Title="{Binding Title}" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">
    <ContentControl x:Name="ShellRegion"
                    AutomationProperties.AutomationId="ShellRegion"
                    prism:RegionManager.RegionName="{x:Static mvvm:RegionNames.Shell}" />
</Window>
