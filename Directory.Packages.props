<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ServiceStackVersion>10.5.0</ServiceStackVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Primitives" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Resilience" Version="11.0.0" />

    <PackageVersion Include="Polly" Version="8.6.4" />
    <PackageVersion Include="Prism.DryIoc" Version="8.1.97" />
    <PackageVersion Include="Prism.Wpf" Version="8.1.97" />
    <PackageVersion Include="Prism.Core" Version="8.1.97" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
   <PackageVersion Include="FlaUI.UIA3.Signed" Version="5.0.0" />
   <PackageVersion Include="FlaUI.Core.Signed " Version=""5.0.0 />
   <PackageVersion Include="Interop.UIAutomationClient.Signed" Version="10.19041.0" />
   <PackageVersion Include="FastExpressionCompiler" Version="6.0.0" />
   <PackageVersion Include="DryIoc.Microsoft.DependencyInjection" Version="6.2.0" />
   <PackageVersion Include="gong-wpf-dragdrop" Version="4.0.0" />
   <PackageVersion Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
   <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
   <PackageVersion Include="Xunit.DependencyInjection" Version="12.0.1" />

  <PackageVersion Include="ServiceStack" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.Interfaces" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.Client" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.HttpClient" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.Text" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.Common" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.Server" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.Kestrel" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.Extensions" Version="$(ServiceStackVersion)" />

    <!-- OrmLite -->
    <PackageVersion Include="ServiceStack.OrmLite" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.OrmLite.Sqlite" Version="$(ServiceStackVersion)" />
    <!-- Web / UI -->
    <PackageVersion Include="ServiceStack.Mvc" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.Jobs" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.Api.OpenApi" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.Admin" Version="$(ServiceStackVersion)" />

    <!-- Logging -->
    <PackageVersion Include="ServiceStack.Logging.Serilog" Version="$(ServiceStackVersion)" />

   <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
   <PackageVersion Include="EntityFrameworkCore.Testing.NSubstitute" Version="11.0.0-rc01" />
   <PackageVersion Include="MockQueryable.NSubstitute" Version="11.0.0" />

    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>
</Project>
