  </ItemGroup>

  <!-- OpenTelemetry -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryVersion)" />
  </ItemGroup>

  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="$(XunitV3Version)" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="$(XunitV3Version)" />
    <PackageVersion Include="Xunit.DependencyInjection" Version="12.0.1" />
    <PackageVersion Include="Xunit.Combinatorial" Version="2.2.3-alpha" />
    <PackageVersion Include="Xunit.OpenCategories.V3" Version="2.4.1.138-beta" />

    <PackageVersion Include="nunit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.1" />
    <PackageVersion Include="Reqnroll.NUnit" Version="3.3.3" />

    <PackageVersion Include="Microsoft.TestPlatform.ObjectModel" Version="$(TestPlatformVersion)" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="$(MtpVersion)" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="$(MtpVersion)" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="$(TestPlatformVersion)" />
    <PackageVersion Include="Microsoft.Testing.Extensions.VideoRecorder" Version="1.0.0-alpha.26561.10" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HtmlReport" Version="$(MtpVersion)" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="EntityFrameworkCore.Testing.NSubstitute" Version="11.0.0-rc01" />
    <PackageVersion Include="MockQueryable.NSubstitute" Version="11.0.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="FluentAssertions" Version="8.5.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Verify" Version="$(VerifyVersion)" />
    <PackageVersion Include="Verify.XunitV3" Version="$(VerifyVersion)" />
    <PackageVersion Include="DiffEngine" Version="20.9.0" />
    <PackageVersion Include="Argon" Version="0.38.2" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.1" />
    <PackageVersion Include="FlaUI.Core.Signed" Version="$(FlaUIVersion)" />
    <PackageVersion Include="FlaUI.UIA2.Signed" Version="$(FlaUIVersion)" />
    <PackageVersion Include="FlaUI.UIA3.Signed" Version="$(FlaUIVersion)" />
    <PackageVersion Include="FlaUI.TestUtilities" Version="$(FlaUIVersion)" />
  </ItemGroup>

  <!-- Analyzers -->
  <ItemGroup>
    <PackageVersion Include="AsyncFixer" Version="2.1.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="NsDepCop" Version="3.3.0" />
    <PackageVersion Include="WpfAnalyzers" Version="4.1.1" />
  </ItemGroup>

  <!-- Libraries -->
  <ItemGroup>
    <PackageVersion Include="Ardalis.GuardClauses" Version="5.0.0" />
    <PackageVersion Include="AutoMapper" Version="17.0.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="MediatR" Version="15.0.0" />
    <PackageVersion Include="MediatR.Contracts" Version="2.0.1" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
    <PackageVersion Include="Utf8StringInterpolation" Version="1.3.2" />
    <PackageVersion Include="PolySharp" Version="1.17.1" />
  </ItemGroup>

  <!-- Azure -->
  <ItemGroup>
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <!-- Mail -->
  <ItemGroup>
    <PackageVersion Include="MailKit" Version="$(MailKitVersion)" />
    <PackageVersion Include="MimeKit" Version="$(MailKitVersion)" />
  </ItemGroup>

  <!-- API docs / PDF / installer -->
  <ItemGroup>
    <PackageVersion Include="Scalar.AspNetCore" Version="2.21.0" />
    <PackageVersion Include="QuestPDF" Version="2026.9.2" />
    <PackageVersion Include="Verify.QuestPDF" Version="3.1.0" />
    <PackageVersion Include="WixSharp_wix4" Version="2.14.2" />
  </ItemGroup>

  <!-- DevExpress -->
  <ItemGroup>
    <PackageVersion Include="DevExpress.Wpf" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.Themes.All" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.Scheduling" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.DataAccess" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Document.Processor" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Drawing.Skia" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.RichEdit.Export" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Scaffolding.Core" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Scaffolding.EFCore" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.Accordion" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.Carousel" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.Charts" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.Core.Extensions" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.Diagram" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.Dialogs" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.Docking" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.DocumentViewer.Core" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.ExpressionEditor" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.Gantt" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.Gauges" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.Grid" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Wpf.LayoutControl" Version="$(DevExpressVersion)" />
